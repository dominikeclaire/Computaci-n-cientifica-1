uede ser inmediatamente después del @\n","  dominio_valido = True                                                                                # ni puede ser el último carácter\n","else:\n","    dominio_valido = False\n","\n","if usuario_valido and dominio_valido:\n","   print(\"El correo es válido\")\n","else:\n","     print(\"El correo no es válido\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"16k1oWciJUmh","executionInfo":{"status":"ok","timestamp":1789781615901,"user_tz":300,"elapsed":20104,"user":{"displayName":"Dominik Claire","userId":"16319120875089695965"}},"outputId":"58f4c49f-fe25-492a-9848-b63307657841"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Ingrese un correo electrónico: dominike.claire@gmail.com\n","El correo no es válido\n"]}]},{"cell_type":"code","source":["# Punto 9. Compresor y Descompresor de Cadenas por RLE con Anidamiento Sencillo\n","# Compresor:\n","\n","cadena = input(\"Ingrese una cadena: \")\n","\n","comprimida = \"\"\n","contador = 1\n","\n","for i in range(len(cadena)):\n","\n","    if i < len(cadena) - 1 and cadena[i] == cadena[i + 1]:\n","        contador += 1\n","\n","    else:\n","        comprimida = comprimida + cadena[i] + str(contador)\n","        contador = 1\n","\n","print(\"Cadena comprimida:\", comprimida)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"STA5SR-ONYOc","executionInfo":{"status":"ok","timestamp":1789781625636,"user_tz":300,"elapsed":9733,"user":{"displayName":"Dominik Claire","userId":"16319120875089695965"}},"outputId":"327b9346-adf5-49d1-a689-65014758ff88"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Ingrese una cadena: aaaajdksaaa\n","Cadena comprimida: a4j1d1k1s1a3\n"]}]},{"cell_type":"code","source":["# Punto 9. Compresor y Descompresor de Cadenas por RLE con Anidamiento Sencillo\n","# Descompresor:\n","\n","cadena = input(\"Ingrese una cadena comprimida: \")\n","\n","descomprimida