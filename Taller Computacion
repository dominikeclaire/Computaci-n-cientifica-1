Código Morse:\", resultado)"],"metadata":{"id":"kAbT6LHyQZQD"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Punto 15. Implemente un algoritmo que encuentre los numeros primos gemelos en un rango de numeros. Estos son\n","#          números primos separados por un número (es decir, que tienen una diferencia de 2 unidades y un número compuesto en medio)\n","\n","def es_primo(numero):\n","\n","    if numero < 2:\n","        return False\n","\n","    for i in range(2, numero):\n","        if numero % i == 0:\n","            return False\n","\n","    return True\n","\n","\n","inicio = int(input(\"Ingrese el inicio del rango: \"))\n","fin = int(input(\"Ingrese el final del rango: \"))\n","\n","print(\"Primos gemelos:\")\n","\n","for numero in range(inicio, fin - 1):\n","\n","    if es_primo(numero) and es_primo(numero + 2):\n","        print(numero, \"y\", numero + 2)"],"metadata":{"id":"z1YcnZvtQaOu"},"execution_count":null,"outputs":[]}]}