er] = 1\n","\n","print(\"Cantidad de ocurrencias:\")\n","\n","for caracter, cantidad in ocurrencias.items():\n","    print(caracter, \":\", cantidad)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Pw46zwtVHvP4","executionInfo":{"status":"ok","timestamp":1789781559689,"user_tz":300,"elapsed":15923,"user":{"displayName":"Dominik Claire","userId":"16319120875089695965"}},"outputId":"bbe72999-b9cf-42b0-bb9f-33c7149daaaf"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Ingrese una frase: esta es una frase generica\n","Cantidad de ocurrencias:\n","e : 5\n","s : 3\n","t : 1\n","a : 4\n","  : 4\n","u : 1\n","n : 2\n","f : 1\n","r : 2\n","g : 1\n","i : 1\n","c : 1\n"]}]},{"cell_type":"code","source":["# Punto 7. Realiza un algoritmo que tome como entrada 3 puntos x,y del plano cartesiano,\n","#          formando un triangulo, como salida el programa calcule al area y perimetro.\n","\n","import math\n","\n","# Coordenadas de los tres puntos\n","x1 = float(input(\"Ingrese x1: \"))\n","y1 = float(input(\"Ingrese y1: \"))\n","\n","x2 = float(input(\"Ingrese x2: \"))\n","y2 = float(input(\"Ingrese y2: \"))\n","\n","x3 = float(input(\"Ingrese x3: \"))\n","y3 = float(input(\"Ingrese y3: \"))\n","\n","# Calcular la longitud de cada lado\n","lado1 = math.sqrt((x2 - x1)**2 + (y2 - y1)**2)\n","lado2 = math.sqrt((x3 - x2)**2 + (y3 - y2)**2)\n","lado3 = math.sqrt((x1 - x3)**2 + (y1 - y3)**2)\n","\n","perimetro = lado1 + lado2 + lado3\n","\n","# Calcular el area usando la fórmula de Herón\n","s = perimetro / 2\n","area = math.sqrt(s * (s - lado1) * (s - lado2) * (s - lado3))\n","\n","print(\"Lado 1:\", lado1)\n","print(\"Lado 2:\", lado2)\n","print(\"Lado 3:\", lado3)\n","print(\"Perímetro:\", perimetro)\n","print(\"Área:\", area)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"P5xPvz5WIOzb","executionInfo":{"status":"ok","timestamp":1789781595793,"user_tz":300,"elapsed":36102,"user":{"displayName":"Dominik Claire"